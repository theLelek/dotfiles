{
    "layer": "top",

    "modules-left": ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right": ["clock", "wireplumber"],

    "hyprland/workspaces": {
        "format": "{icon}",
	    "format-icons": {
		    "visible": "",
		    "default": ""
	    }
    },

    "clock": {
        "name": "highlighted",
        "timezone": "",
	    "format": "{:%R %a %d.%m}",
	    "tooltip-format": "<tt><small>{calendar}</small></tt>",
	    "actions": {
		    "on-click-right": "mode",
		    "on-click-forward": "tz_up",
		    "on-click-backward": "tz_down",
		    "on-scroll-up": "shift_up",
		    "on-scroll-down": "shift_down"
	    }
    },

    "wireplumber": {
        "name": "highlighted",
	    "format": "{volume}%",
        "format-muted": "🔇{volume}%",
        "smooth-scrolling-threshold": 0.5,
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
}
