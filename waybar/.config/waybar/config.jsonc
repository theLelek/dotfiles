{
    "layer": "top",

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["clock"],

    "hyprland/window": {
        "max-length": 50
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
        "timezone": ""
    },

    "hyprland/workspaces": {
	    "format": "{icon}",
	    "format-icons": {
		    "visible": "",
		    "default": ""
	    }
    }
}
